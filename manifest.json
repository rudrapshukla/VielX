{
  "manifest_version": 3,
  "name": "VeilX",
  "version": "1.2.0",
  "description": "Hybrid post-quantum (ML-KEM-768 + P-256) end-to-end encryption with forward secrecy and encrypted media sidecars for Instagram Direct.",
  "author": "Team Monolith (Rudra Pratap Shukla)",
  "homepage_url": "https://veilxweb.onrender.com",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.instagram.com/*",
    "https://*.facebook.com/*",
    "https://veilx-relay.therealrudrashukla.workers.dev/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "composer/composer.html"
      ],
      "matches": [
        "https://www.instagram.com/*",
        "https://*.instagram.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "all_frames": true,
      "matches": [
        "https://www.instagram.com/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "src/crypto.js",
        "src/protocol.js",
        "src/util.js",
        "src/store.js",
        "src/session.js",
        "src/styles.js",
        "src/dom.js",
        "src/ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
