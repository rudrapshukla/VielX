{
  "manifest_version": 3,
  "name": "VeilX",
  "version": "5.2.0",
  "description": "NIST FIPS 203 ML-KEM-768 + ECDH P-256 + AES-256-GCM encryption & VeilX Studio for Instagram Direct.",
  "author": "Team Monolith",
  "homepage_url": "https://github.com/rudrapshukla",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.instagram.com/*",
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "composer/composer.html",
        "app/app.html"
      ],
      "matches": [
        "https://www.instagram.com/*",
        "https://*.instagram.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "all_frames": true,
      "matches": [
        "https://www.instagram.com/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "src/crypto.js",
        "src/util.js",
        "src/store.js",
        "src/styles.js",
        "src/dom.js",
        "src/ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}